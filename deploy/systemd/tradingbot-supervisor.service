[Unit]
Description=TradingbotR1000 Health Supervisor
After=network-online.target tradingbot-ibgateway.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ibkradmin
WorkingDirectory=/home/ibkradmin/trading/TradingbotR1000/current_reference/PaperTradingR1000
ExecStart=/home/ibkradmin/trading/venv/bin/python -X utf8 -B -u health_supervisor.py --interval 60
Restart=on-failure
RestartPreventExitStatus=10
RestartSec=5

[Install]
WantedBy=multi-user.target
